  "components": {
    "securitySchemes": {
      "Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Token <clave>"
      }
    },
    "schemas": {
      "Operacion": {
        "type": "object",
        "required": [
          "operacion_id",
          "prestamo_id",
          "estado",
          "resultado"
        ],
        "properties": {
          "operacion_id": {
            "type": "string",
            "format": "uuid"
          },
          "prestamo_id": {
            "type": "integer",
            "format": "int64"
          },
          "estado": {
            "enum": [
              "reservando",
              "confirmando",
              "compensando",
              "liberando",
              "completada",
              "fallida"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "resultado": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
