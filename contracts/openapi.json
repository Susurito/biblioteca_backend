    "/token/": {
      "post": {
        "summary": "Login por username, correo completo o matrícula",
        "responses": {
          "200": {
            "description": "Login por username, correo completo o matrícula"
          },
          "400": {
            "description": "Datos o transición inválidos"
          },
          "401": {
            "description": "Token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "503": {
            "description": "Dependencia indisponible"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
