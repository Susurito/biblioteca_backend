# ====================================================
# Plantilla de Variables de Entorno - Biblioteca Backend
# Copia este archivo como .env y ajusta los valores necesarios
# ====================================================

# Django
DJANGO_SECRET_KEY=solo-para-desarrollo-local-nunca-usar-en-produccion
DJANGO_DEBUG=True

# Base de datos MySQL
DB_HOST=db
DB_NAME=biblioteca1_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_PORT=3306

# Three-service migration. Use URL-safe passwords (letters and numbers) for AMQP.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-key
MYSQL_ADMIN_PASSWORD=replaceAdminPassword
IDENTIDAD_DB_PASSWORD=replaceIdentityPassword
LIBROS_DB_PASSWORD=replaceBooksPassword
PRESTAMOS_DB_PASSWORD=replaceLoansPassword
RABBITMQ_PASSWORD=replaceRabbitPassword
LEGACY_DB_PASSWORD=rootpassword
# Phase 0: all traffic and loan summaries stay on the monolith.
IDENTITY_UPSTREAM=web:8000
BOOKS_UPSTREAM=web:8000
LOANS_UPSTREAM=web:8000
FALLBACK_UPSTREAM=web:8000
IDENTITY_AUTH_ENABLED=0
CATALOG_REMOTE_ENABLED=0
LOANS_OWNER_URL=http://web:8000

# Block public writes while exporting/importing a context.
MAINTENANCE_MODE=0

# After completing and reconciling the migration, persist the final deployment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.final.yml
